# 可选：GitHub Actions 冒烟检查（示例文件）
#
# 想启用 CI，把它复制到 `.github/workflows/ci.yml` 再 push。
# 注意：用 PAT 推送含 workflow 文件的提交时，token 必须带 `workflow` 权限，
#       否则 GitHub 会拒绝（报 "refusing to allow a Personal Access Token to create
#       or update workflow ... without workflow scope"）。
#
# 这个 CI 只做不依赖模型的检查（语法 + CLI 子命令），不跑转写：
#   mkdir -p .github/workflows && cp docs/ci.yml.example .github/workflows/ci.yml

name: ci

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

jobs:
  smoke:
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest]
        python-version: ["3.10", "3.12"]
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}

      - name: 语法检查（全部源码可编译）
        run: python -m compileall -q voicepack tools

      - name: CLI 冒烟（--help 与子命令齐全）
        run: |
          python -m voicepack --help
          python -m voicepack build --help

      - name: 轻量依赖 + 扫描空目录（不下载 Whisper 模型）
        run: |
          python -m pip install --quiet --upgrade pip
          python -m pip install --quiet "Pillow>=10" "numpy>=1.26"
          python -m voicepack scan . || echo "(空目录扫描返回非 0 属正常)"
